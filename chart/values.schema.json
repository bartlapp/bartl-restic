{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "installation",
    "renderMode",
    "services"
  ],
  "$comment": "Selected deployment, package, operation intent and services.<instance> are validated against interface.schema.json; unrelated inputs are ignored.",
  "properties": {
    "installation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "instance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "deployment": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "renderMode": {
      "type": "string",
      "enum": [
        "deployment",
        "connections"
      ]
    },
    "dns": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 239,
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"
        }
      }
    },
    "services": {
      "type": "object"
    },
    "image": false,
    "application": false,
    "existingClaim": false,
    "tlsSecret": false,
    "repositories": false,
    "replication": false,
    "maintenance": false
  }
}
