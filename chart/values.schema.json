{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["existingClaim", "tlsSecret", "repositories", "maintenance"],
  "properties": {
    "existingClaim": {"type": "string", "minLength": 1},
    "tlsSecret": {"type": "string", "minLength": 1},
    "repositories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "authSecret"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,56}[a-z0-9])?$"},
          "authSecret": {"type": "string", "minLength": 1}
        }
      }
    },
    "maintenance": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "name", "repository", "action", "snapshot", "host", "credentialsSecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
        "repository": {"type": "string"},
        "action": {"enum": ["check", "forget-prune"]},
        "snapshot": {"type": "string"},
        "host": {"type": "string", "pattern": "^([a-zA-Z0-9][a-zA-Z0-9.-]*[a-zA-Z0-9]|[a-zA-Z0-9])?$"},
        "credentialsSecret": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"enabled": {"const": true}}}, "then": {
          "properties": {
            "repository": {"minLength": 1},
            "host": {"minLength": 1},
            "credentialsSecret": {"minLength": 1}
          }
        }},
        {"if": {"properties": {"action": {"const": "forget-prune"}}}, "then": {
          "properties": {"snapshot": {"pattern": "^[a-f0-9]{64}$"}}
        }}
      ]
    }
  }
}
